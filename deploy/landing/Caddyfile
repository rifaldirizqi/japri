# Landing page Japri. Tempel blok ini di /etc/caddy/Caddyfile di VPS,
# terus: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# HTTPS (Let's Encrypt) diurus otomatis sama Caddy, asal record DNS-nya udah ngarah ke VPS.
japri.rifaldirizqi.web.id {
	root * /var/www/japri
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Gambar & ikon jarang berubah: boleh di-cache seminggu. HTML selalu dicek ulang biar update langsung keliatan.
	@assets path *.png *.svg *.ico
	header @assets Cache-Control "public, max-age=604800"
	@html path / *.html
	header @html Cache-Control "no-cache"

	handle_errors {
		@404 expression {err.status_code} == 404
		redir @404 / 302
	}
}
